{
  "name": "placekey-excel-addin",
  "version": "1.0.2",
  "private": true,
  "type": "module",
  "description": "Placekey Excel Add-in (Office.js taskpane)",
  "scripts": {
    "dev": "vite --host localhost --port 3000",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "lint": "eslint 'src/**/*.js' 'test/**/*.{js,mjs}'",
    "format:check": "prettier --check 'src/**/*.{js,html,css}' 'test/**/*.{js,mjs}' '*.md'",
    "format": "prettier --write 'src/**/*.{js,html,css}' 'test/**/*.{js,mjs}' '*.md'",
    "validate-manifest": "office-addin-manifest validate manifest.xml",
    "rewrite-manifest": "node scripts/manifest-prod.js"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@vitest/coverage-v8": "^4.1.4",
    "eslint": "^10.2.1",
    "happy-dom": "^20.9.0",
    "office-addin-manifest": "^2.1.3",
    "prettier": "^3.2.0",
    "vite": "^8.0.8",
    "vitest": "^4.1.4"
  },
  "overrides": {
    "uuid": "^14.0.0"
  }
}
