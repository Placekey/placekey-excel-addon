{
  "name": "placekey-excel-addin",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Placekey Excel Add-in (Office.js taskpane)",
  "scripts": {
    "dev": "vite --host localhost --port 3000",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "lint": "eslint 'src/**/*.js' 'test/**/*.mjs'",
    "format:check": "prettier --check 'src/**/*.{js,html,css}' 'test/**/*.mjs' '*.md'",
    "format": "prettier --write 'src/**/*.{js,html,css}' 'test/**/*.mjs' '*.md'",
    "validate-manifest": "office-addin-manifest validate manifest.xml",
    "rewrite-manifest": "node scripts/manifest-prod.js"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^3.0.0",
    "eslint": "^9.0.0",
    "happy-dom": "^20.9.0",
    "office-addin-manifest": "^1.13.0",
    "prettier": "^3.2.0",
    "vite": "^7.0.0",
    "vitest": "^3.0.0"
  }
}
